# ---------------------------------------------------------------------------
# server/.env.example
#
# THIS FILE IS COMMITTED TO GIT. It documents which variables exist.
# Every value here is a placeholder. Never put a real secret in this file.
#
# To set up locally:   cp .env.example .env   then edit .env
# .env is gitignored.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# Port the Express API listens on locally.
# In production, Railway injects its own PORT — the code must read this var
# rather than hard-coding 4000, or the deploy will fail health checks.
PORT=4000

# "development" | "production" | "test"
# Controls things like whether error responses include stack traces.
NODE_ENV=development

# --- Database (wired up in step 2) -----------------------------------------

# Postgres connection string from the Neon dashboard.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Auth (wired up in step 4) ---------------------------------------------

# Secret used to sign JWTs. Anyone who has this can forge a login for any
# user, so it must be long, random, and different in every environment.
# Generate one with:  openssl rand -base64 32
JWT_SECRET="replace-me-with-openssl-rand-base64-32"

# --- CORS (wired up in step 3) ---------------------------------------------

# Exact origin of the frontend, used to allow cross-origin requests.
# Local dev: http://localhost:5173
# Production: https://your-app.vercel.app  (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173
