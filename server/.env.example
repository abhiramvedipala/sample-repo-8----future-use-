# ---------------------------------------------------------------------------
# server/.env.example
#
# THIS FILE IS COMMITTED TO GIT. It documents which variables exist.
# Every value here is a placeholder. Never put a real secret in this file.
#
# To set up locally:   cp .env.example .env   then edit .env
# .env is gitignored.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# Port the Express API listens on locally.
# In production, Railway injects its own PORT — the code must read this var
# rather than hard-coding 4000, or the deploy will fail health checks.
PORT=4000

# "development" | "production" | "test"
# Controls things like whether error responses include stack traces.
NODE_ENV=development

# --- Database --------------------------------------------------------------

# DATABASE_URL is used by the RUNNING APP (src/lib/prisma.ts).
# DIRECT_URL   is used by MIGRATIONS (prisma.config.ts).
#
# They differ in production only. Neon puts a connection pooler in front of
# your database; the app wants the pooled endpoint (many short-lived queries),
# but migrations need an unpooled one (they take session-level locks that a
# pooler would break).
#
# Local development: no pooler exists, so both point at the same database.
#
#   Local:
#     DATABASE_URL="postgresql://user:password@127.0.0.1:5432/jobtracker_dev"
#     DIRECT_URL="postgresql://user:password@127.0.0.1:5432/jobtracker_dev"
#
#   Neon (note "-pooler" in the first host and not the second):
#     DATABASE_URL="postgresql://user:pw@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
#     DIRECT_URL="postgresql://user:pw@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
#
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/jobtracker_dev"
DIRECT_URL="postgresql://user:password@127.0.0.1:5432/jobtracker_dev"

# --- Auth (wired up in step 4) ---------------------------------------------

# Secret used to sign JWTs. Anyone who has this can forge a login for any
# user, so it must be long, random, and different in every environment.
# Generate one with:  openssl rand -base64 32
JWT_SECRET="replace-me-with-openssl-rand-base64-32"

# --- CORS -------------------------------------------------------------

# Exact origin of the frontend, used to allow cross-origin requests.
# Local dev: http://localhost:5173
# Production: https://your-app.vercel.app  (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173
