# ---------------------------------------------------------------------------
# client/.env.example
#
# THIS FILE IS COMMITTED TO GIT. It documents which variables exist.
#
# !!! READ THIS !!!
# Frontend env vars are NOT secret. Vite finds every VITE_-prefixed variable
# at build time and substitutes its literal value into the JavaScript bundle
# that gets shipped to the browser. Anyone can read them with DevTools.
#
# Never put a database URL, an API key, or a JWT secret in this file or in
# client/.env. Those belong in server/.env only.
#
# The VITE_ prefix is required: Vite refuses to expose variables without it,
# specifically so that a stray AWS_SECRET_KEY in your shell doesn't leak into
# a public bundle by accident.
# ---------------------------------------------------------------------------

# Base URL of the Express API. This is the seam: every fetch() the React app
# makes points here, and it is a DIFFERENT ORIGIN from the frontend, which is
# why the backend needs CORS configured.
#
# Local dev:  http://localhost:4000
# Production: https://your-api.up.railway.app  (no trailing slash)
VITE_API_URL=http://localhost:4000
